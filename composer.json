{
  "name": "harunsekmen/apex-commerce-d2c-starter",
  "description": "Ultra-fast modern D2C e-commerce starter kit for WooCommerce with native slide drawer and sticky checkout.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Harun Sekmen",
      "homepage": "https://github.com/harunsekmen"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "ApexCommerce\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}

